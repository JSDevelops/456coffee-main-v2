# ==========================================================================
# 456cafe backend — environment template
# Copy to .env and fill in real values for each environment.
# ==========================================================================

# ───── Runtime ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001

# ───── Database (Prisma) ───────────────────────────────────────────────────
# Local dev (Docker Compose):
DATABASE_URL=postgresql://cafe:cafepw@localhost:5432/cafe?schema=public

# Production examples — pick one:
# Render Postgres:    postgresql://USER:PASS@HOST:PORT/DB?schema=public&sslmode=require
# Neon:               postgresql://USER:PASS@ep-xxx.region.aws.neon.tech/DB?sslmode=require
# Supabase:           postgresql://postgres:PASS@db.xxx.supabase.co:5432/postgres

# ───── JWT ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-32+char-random-string
JWT_EXPIRES_IN=30d

# ───── Admin login (env-based until DB-backed admins land) ─────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=set-a-strong-password-here

# ───── POS staff login ─────────────────────────────────────────────────────
# Shared PIN for all branch POS terminals. Rotate periodically.
POS_PIN=4567

# ───── CORS allowlist (comma-separated) ────────────────────────────────────
# Leave empty for permissive (dev). Set explicit origins in production.
# CORS_ORIGIN=https://admin.example.com,https://pos.example.com,https://liff.example.com

# ───── External services ───────────────────────────────────────────────────
# Optional — enables /api/ai/recommend and /api/ai/translate.
# GEMINI_API_KEY=

# ───── LINE LIFF (buyer-liff) ──────────────────────────────────────────────
# Required in production to verify LIFF access tokens belong to your channel.
LINE_CHANNEL_ID=

# ───── OTP ─────────────────────────────────────────────────────────────────
# Mock OTP is disabled automatically when NODE_ENV=production.
# Set only for controlled staging, never for public production.
# OTP_MOCK_ENABLED=false
